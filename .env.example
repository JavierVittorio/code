# Any OpenAI-compatible endpoint. Defaults target OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
# Vision-capable model. Free OpenRouter models end in ":free".
LLM_MODEL=google/gemma-4-31b-it:free
# Optional fallback models (comma-separated) tried on 429/5xx/unavailable.
LLM_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free
# List-price-equivalent USD per 1M tokens, used for cost reporting when the model is free.
PRICE_IN_PER_MTOK=0.25
PRICE_OUT_PER_MTOK=0.75
# Concurrency and resilience
MAX_CONCURRENCY=3
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=4
# Image optimization (the measured optimization; set IMAGE_PROFILE=raw to disable)
IMAGE_PROFILE=optimized
# Confidence threshold below which a field is abstained
ABSTAIN_THRESHOLD=0.5
CACHE_DIR=.cache/llm
