# Any OpenAI-compatible endpoint. Defaults target OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
# Vision-capable model. Free OpenRouter models end in ":free".
LLM_MODEL=google/gemma-4-31b-it:free
# Fallback models (comma-separated), tried after 1 retry on 429/5xx. Paid twin of the free model by default.
LLM_FALLBACK_MODELS=google/gemma-4-31b-it
# List-price-equivalent USD per 1M tokens, used for cost reporting when the model is free.
PRICE_IN_PER_MTOK=0.09
PRICE_OUT_PER_MTOK=0.34
# Concurrency and resilience
MAX_CONCURRENCY=3
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=4
# Image optimization (the measured optimization; set IMAGE_PROFILE=raw to disable)
IMAGE_PROFILE=optimized
# Confidence threshold below which a field is abstained. Unset = value fitted by tools/calibrate.py
# ABSTAIN_THRESHOLD=0.5
CACHE_DIR=.cache/llm
